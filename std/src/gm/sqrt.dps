import std::types::base::str;
import std::types::base::float;
import std::types::base::double;
import std::types::entities::Entity;
import std::entity::tp;
import std::gm::gm_std;
import std::gm::math_entity;
import std::math::sub;
import std::intrinsics::slice;
import std::intrinsics::float_of;
import std::intrinsics::dsl_entity_id;

const looper: Entity = @"__sqrt_loop";

// Compiler note: structs are only used for compile-time type checking
// they are always represented as NBT objects in data storage
struct SqrtTemp {
    var1: float,
    var2: float,
    var3: [double; 16],
    var4: [float; 16],
    v1m2p: str,
}

pub fn gm_sqrt(x: float) -> float {
    gm_std[looper] = 0;

    let temp: SqrtTemp = {
        var1: x,
        var2: 1f,
        var3: [0d, 0d, 0d, 0d, 0d, 1d, 0d, 0d, 0d, 0d, 1d, 0d, 0d, 0d, 0d, 2d],
        var4: [0f, 0f, 0f, x, 0f, 1f, 0f, 0f, 0f, 0f, 1f, 0f, 0f, 0f, 0f, 0f],
        v1m2p: "",
    };

    return sqrt_handling(x, 1f, temp);
}

// ref just ensures the object is not cloned
fn sqrt_handling(var1: float, var2: float, ref temp: SqrtTemp) -> float {
    at @[~, var1, ~] {
        math_entity.tp(@[29999999, ~var2, 91665]);
    }

    temp.var3 = [temp.var3[0], math_entity.Pos[1], temp.var3[2]];
    math_entity.transformation = temp.var3;
    temp.var1 = math_entity.transformation.translation[0];

    temp.var4[15] = temp.var1;
    math_entity.transformation = temp.var4;
    temp.var2 = math_entity.transformation.translation[0];

    gm_std[looper] += 1;
    positive_subtract(var2, temp);

    if (gm_std[looper] < 20) && temp.v1m2p != "-" {
        sqrt_handling(temp.var1, temp.var2, temp);
    }

    math_entity.tp(@[29999999, 0, 91665]);

    return temp.var1;
}

fn positive_subtract(var2: float, ref temp: SqrtTemp) {
    let var1f = float_of(temp.var1);

    at @[~, var1f, ~] {
        at @[~, ~ - 0.000000001, ~] {
            math_entity.tp(@[29999999, ~ -var2, 91665]);
        }
    }

    let y_str = str_of(math_entity.Pos[1]);

    temp.v1m2p = y_str.slice(0, 1);
}
