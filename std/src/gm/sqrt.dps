module std/gm/sqrt;

import std/base/{tp_pos};
import std/data/{set_string_entity};
import std/gm/core/{gm_std, math_entity, invalid_input};

const looper = selector: "__sqrt_loop";

pub fn sqrt(x: float) -> float {
    gm_std[looper] = 0;

    let temp = nbt: {
        var1: x,
        var2: 1,
        var3: [0d, 0d, 0d, 0d, 0d, 1d, 0d, 0d, 0d, 0d, 1d, 0d, 0d, 0d, 0d, 2d],
        var4: [0f, 0f, 0f, x, 0f, 1f, 0f, 0f, 0f, 0f, 1f, 0f, 0f, 0f, 0f, 0f],
    };

    return sqrt_handling(x, 1, temp);
}

fn sqrt_handling(var1: float, var2: float, ref temp: NBT) {
    at pos: [~, var1, ~] {
        tp_pos(math_entity, pos: [29999999, ~var2, 91665]);
    }

    temp.var3[3] = math_entity.Pos[1];
    math_entity.transformation = temp.var3;
    temp.var1 = math_entity.transformation.translation[0];
    temp.var4[-1] = temp.var1;
    math_entity.transformation = temp.var4;
    temp.var2 = math_entity.transformation.translation[0];

    gm_std[looper] += 1;
    positive_subtract(temp);

    if gm_std[looper] != 20.. && temp.v1m2p != "-" {
        sqrt_handling(temp.var1, temp.var2, temp);
    }

    tp_pos(math_entity, pos: [29999999, 0, 91665]);

    return temp.var1;
}

fn positive_subtract(ref data: NBT) {
    at pos: [~, data.var1, ~] {
        at pos: [~, ~-0.000000001, ~] {
            tp_pos(math_entity, pos: [29999999, ~-var2, 91665]);
        }
    }

    set_string_entity(storeof(data), keyof(data), math_entity, "Pos[1]", 0, 1);
}
