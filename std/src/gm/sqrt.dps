import std::entity::tp;
import std::gm::gm_std;
import std::gm::math_entity;
import std::selectors::Pos;
import std::transform::transformation;
import std::transform::translation;
import std::intrinsics::slice;

const looper: Selector = selector: "__sqrt_loop";

pub fn sqrt(x: float) -> float {
    gm_std[looper] = 0;

    let temp = nbt: {
        var1: x,
        var2: 1,
        var3: [0d, 0d, 0d, 0d, 0d, 1d, 0d, 0d, 0d, 0d, 1d, 0d, 0d, 0d, 0d, 2d],
        var4: [0f, 0f, 0f, x, 0f, 1f, 0f, 0f, 0f, 0f, 1f, 0f, 0f, 0f, 0f, 0f],
    };

    return sqrt_handling(x, 1, temp);
}

fn sqrt_handling(var1: float, var2: float, ref temp: NBT) {
    at pos: [~0, var1, ~0] {
        math_entity.tp(pos: [29999999, ~var2, 91665]);
    }

    temp.var3[3] = math_entity.Pos[1];
    math_entity.transformation = temp.var3;
    temp.var1 = math_entity.transformation.translation[0];
    temp.var4[-1] = temp.var1;
    math_entity.transformation = temp.var4;
    temp.var2 = math_entity.transformation.translation[0];

    gm_std[looper] += 1;
    positive_subtract(temp);

    // FIXME: Compiler bug - binary operations don't parse well, this has to be two variables
    // This being two variables also creates an optimization problem

    let a = gm_std[looper] < 20;
    let b = temp.v1m2p != "-";

    // if gm_std[looper] < 20 && temp.v1m2p != "-" {
    // ^^^ This should work, but the compiler parses it as
    // gm_std[looper] < ((20 && temp.v1m2p) != "-") (or something in the same vein)
    // which doesn't make any sense.
    // FIXME!! PLEASE!!

    if a && b {
        sqrt_handling(temp.var1, temp.var2, temp);
    }

    math_entity.tp(pos: [29999999, 0, 91665]);

    return temp.var1;
}

fn positive_subtract(ref temp: NBT) {
    at pos: [~0, temp.var1, ~0] {
        at pos: [~0, ~-0.000000001, ~0] {
            math_entity.tp(pos: [29999999, ~-var2, 91665]);
        }
    }

    temp.v1m2p = math_entity.Pos[1].slice(0, 1);
}
