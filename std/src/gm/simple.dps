import std::gm::gm_std;
import std::gm::math_entity;
import std::intrinsics::float_of;
import std::intrinsics::stringify;
import std::entity::tp;
import std::intrinsics::slice;

pub fn gm_add(x: float, y: float) -> float {
    at @[~, x, ~] {
        math_entity.tp(@[29999999, ~y, 91665]);
    }

    let result = math_entity.Pos[1];

    math_entity.tp(@[29999999, 0, 91665]);

    return result;
}

pub fn gm_sub(x: float, y: float) -> float {
    let var2 = y;
    let tv2p = y.slice(0, 1);
    let v2p = "-";
    let v2s = "";

    if tv2p == "-" {
        // var2 is float but has to be a string for slicing and converted back to float.....
        v2s = var2.slice(1);
        v2p = "";
    }

    at @[~, x, ~] {
        math_entity.tp(@[29999999, float_of(v2p + v2s), 91665]); // "v2p + var2" is string concatenation. cursed.
    }

    let result = math_entity.Pos[1];

    math_entity.tp(@[29999999, 0, 91665]);

    return result;
}

pub fn gm_mul(x: float, y: float) -> float {
    // compiler note: this is inferred to be a [float; 16]
    // yes those are floats, can i just put 0 and 1?
    let var1 = [0f,0f,0f,x,0f,1f,0f,0f,0f,0f,1f,0f,0f,0f,0f,1f];

    // same lol
    math_entity.transformation = [0f,0f,0f,1f,0f,1f,0f,0f,0f,0f,1f,0f,0f,0f,0f,y];

    var1[15] = math_entity.transformation.translation[0];

    math_entity.transformation = var1;

    return math_entity.transformation.translation[0];
}

pub fn gm_div(x: float, y: float) -> float {
    // don't you love when 0f
    math_entity.transformation = [0f,0f,0f,x,0f,1f,0f,0f,0f,0f,1f,0f,0f,0f,0f,y];

    return math_entity.transformation.translation[0]; // FIXME: is this math_entity or @s?
}

pub fn gm_negate(x: float) -> float {
    let var1 = stringify(x);
    let tv2p = var1.slice(0, 1);
    let v2p = "-";

    if tv2p == "-" {
        var1 = var1.slice(1);
        v2p = "";
    }

    return float_of(v2p + var1);
}

