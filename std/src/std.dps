module std;

export advops::*;
export array::*;
export base::*;
export cond::*;
export core::*;
export data::*;
export scoreboard::*;
export selectors::*;

import std::base::tellraw;
import std::selectors::all_players;
import std::scoreboard::{not_equal, set_score};

pub objective enable_message: dummy = "enable_std_hello";
pub const config = entity: "config";

// FIXME: This shouldn't be necessary.
import std::config;

init {
    const welcome = [c: "Thank you for using DPScript!" & nbt: { bold: true }];
    const hint_base = c: "Hint: " & nbt: { bold: true, color: "gold" };
    const disable = c: "You can disable this message by running:\n" & nbt: { color: "dark_aqua" };
    const cmd = c: "/scoreboard players set config enable_std_hello 0\n" & nbt: { bold: true, color: "gray" };
    
    const click = c: "[Click to copy!]" & nbt: {
        bold: true,
        color: "dark_aqua",
        clickEvent: {
            action: "copy_to_clipboard",
            value: "/scoreboard players set config enable_std_hello 0"
        },
        hoverEvent: {
            action: "show_text",
            contents: ["Copy: /scoreboard players set config enable_std_hello 0"],
        },
    };
    
    const hint = [hint_base, disable, cmd, click];

    if enable_message[config] != 0 && enable_message[config] != 1 {
        enable_message[config] = 1;
    } else if enable_message[config] != 0 {
        tellraw(all_players, welcome);
        tellraw(all_players, hint);
    }
}
