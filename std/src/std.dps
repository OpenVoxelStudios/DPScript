import std::selectors::tellraw;
import std::selectors::all_players;
import std::types::text::Text;
import std::types::entities::Entity;
import std::intrinsics::dsl_entity_id;
import std::intrinsics::dsl_plain_text;
import std::intrinsics::add;

#[name = "dpscript_config"]
pub objective config = "dummy";

pub const enable_message: Entity = @"enable_std_hello";

init {
    // compiler note: '#"..."' syntax means text component
    // LSP note: when the left side of a `+` operation is typed NBT, assume the same schema for right side NBT
    const welcome: Text = #"Thank you for using DPScript!" + { bold: true };
    const hint_base: Text = #"Hint: " + { bold: true, color: "gold" };
    const disable: Text = #"You can disable this message by running:\n" + { color: "dark_aqua" };
    const cmd: Text = #"/scoreboard players set enable_std_hello dpscript_config 0\n" + { bold: true, color: "gray" };
    
    const click: Text = #"[Click to copy!]" + {
        bold: true,
        color: "dark_aqua",

        clickEvent: {
            action: "copy_to_clipboard",
            value: "/scoreboard players set enable_std_hello dpscript_config 0"
        },

        hoverEvent: {
            action: "show_text",
            contents: [#"Copy: /scoreboard players set enable_std_hello dpscript_config 0"],
        },
    };
    
    const hint: Text = [hint_base, disable, cmd, click];

    if !config[enable_message] { // matches -2147483648..2147483647
        config[enable_message] = 1;
    }
    
    if config[enable_message] != 0 {
        all_players.tellraw(welcome);
        all_players.tellraw(hint);
    }
}
