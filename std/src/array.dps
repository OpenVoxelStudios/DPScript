module std::array;

pub objective array_len: dummy = "__dpscript_array_len";
pub objective array_pos: dummy = "__dpscript_array_pos";

pub const array_state = selector: "__dpscript_state";

pub fn array_add_all(ref arr: Any[], add: Any[]) {
    #[gen] const state: Selector;

    array_pos[state] = 0;
    array_len[state] = len(add);

    goto appender;

    sub appender {
        if array_pos[state] < array_len[state] {
            arr.push(add[array_pos[state]]);
            array_pos[state]++;
            goto appender;
        }
    }
}

