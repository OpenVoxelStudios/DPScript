/// Display entities are entities useful for map or data pack creators to display various things. There
/// are Block Displays, Item Displays and Text Displays, which are used to display blocks, items and
/// texts respectively.
#[allow(incomplete)]
pub struct DisplayEntity extends Entity {
    /// Controls if this entity should pivot to face player when rendered. It can be fixed (both
    /// vertical and horizontal angles are fixed), vertical (faces player around vertical axis),
    /// horizontal (pivots around horizontal axis), and center (pivots around center point). Defaults
    /// to fixed.
    #[nullable]
    billboard: BillboardType;

    /// If present, overrides light values used for rendering. Omitted by default (which means rendering
    /// uses values from entity position).
    #[nullable]
    brightness: Brightness;

    /// Overrides the glow border color. If -1, uses the color of the team that the display entity is in.
    /// Defaults to -1. Is not preserved when removed.
    #[nullable]
    glow_color_override: int;

    /// The maximum height of the entity. Rendering culling bounding box spans vertically y to y+height,
    /// and the part beyond will be culled. If set to 0, no culling on both vertical and horizontal directions.
    /// Defaults to 0.
    #[nullable]
    height: float;

    /// The maximum width of the entity. Rendering culling bounding box spans horizontally width/2 from entity
    /// position, and the part beyond will be culled. If set to 0, no culling on both vertical and horizontal
    /// directions. Defaults to 0.
    #[nullable]
    width: float;

    /// Interpolation duration in ticks.
    #[nullable]
    interpolation_duration: int;

    /// Interpolation duration in ticks for teleportation. Values are clamped between 0 and 59 (inclusive).
    #[nullable]
    #[limit(0, 59)]
    teleport_duration: int;

    /// Delay before starting interpolation. If 0, interpolation starts immediately. (Not saved to entity,
    /// but can be set by commands.)
    #[nullable]
    start_interpolation: int;

    /// Shadow radius. Value is treated as 64 when higher than 64. If less than or equal to 0, the entity
    /// has no shadow. Defaults to 0. Interpolated.
    #[nullable]
    shadow_radius: float;

    /// Controls the opacity of the shadow as a function of distance to block below. Defaults to 1.
    /// Interpolated.
    #[nullable]
    shadow_strength: float;

    /// Maximum view range of the entity. When the distance is more than `<view_range> * <entityDistanceScaling> * 64`,
    /// the entity is not rendered. Defaults to 1.0.
    #[nullable]
    view_range: float;

    /// The rendering transformation applied to model after normal entity orientation, taking the position
    /// of the entity as the origin. Defaults to no transformation. Interpolated.
    #[nullable]
    transformation: Transform;
}

/// Item Display entities can display any item in the game using the item tag.
///
/// Using the Item Display entity with custom_model_data (optional) you can easily display any custom model.
///
/// For the Item Display entity, in addition to directly modifying the NBT, the displayed item can also be
/// modified using the /loot and /item commands with the slot `container.0`.
///
/// Per default, the location of an item display without transformations represents the center of the item.
#[allow(incomplete)]
#[entity_id = "minecraft:item_display"]
pub struct ItemDisplay extends DisplayEntity {
    /// The item to display.
    #[nullable]
    item: ItemStack;
}

/// Block Display entities can display most block in the game using the block_state tag, except for fluid blocks
/// (water and lava), which do not display their own model.
///
/// The location of a block display without transformations represents the north-west-bottom (negative XYZ) corner
/// of the block.
#[allow(incomplete)]
#[entity_id = "minecraft:block_display"]
pub struct BlockDisplay extends DisplayEntity {
    /// The block state to display.
    #[nullable]
    block_state: BlockState;
}

/// Text Display entities can display any text using the text tag.
///
/// The displayed text is only visible from one side, which is without transformations the direction the text display
/// is rotated towards.
///
/// The location of a text display without transformations represents the bottom center of the text.
///
/// By default, each pixel of text is 1/40th of a meter wide.
#[allow(incomplete)]
#[entity_id = "minecraft:text_display"]
pub struct TextDisplay extends DisplayEntity {
    /// Text alignment direction. Can be center, left, and right. Defaults to center.
    #[nullable]
    alignment: TextAlignment;

    /// The background color, arranged by ARGB. Since pixels with an alpha channel less than 0.1 are discarded when
    /// rendering in vanilla shader, the background becomes fully transparent when A is less than 26 (0x1A). Defaults
    /// to 1073741824 (0x40000000). Interpolated.
    #[nullable]
    background: int;

    /// If true, rendering uses default text background color (same as in chat), which overrides background. Defaults
    /// to false.
    #[nullable]
    default_background: bool;

    /// Maximum line width used to split lines (note: new line can be also added with \n characters). Defaults to 200.
    #[nullable]
    line_width: int;

    /// Whether the text is visible through blocks. Defaults to false.
    #[nullable]
    see_through: bool;

    /// Whether the text is displayed with shadow. Defaults to false.
    #[nullable]
    shadow: bool;

    /// The text to be displayed in the format of raw JSON text, which are resolved with the context of the display entity.
    #[nullable]
    #[raw_json] // signals to the compiler that it should be wrapped in a string as raw json text ('{"text": ""}')
    text: Text;

    /// Alpha value of rendered text. Value ranges from 0 to 255. Values up to 3 are treated as fully opaque (255). Similar
    /// to the background, the text rendering is discarded for values between 4 and 26. NBT stores the value as signed byte,
    /// -128 to 127. Defaults to -1, which represents 255 and is completely opaque. SNBT to NBT handles conversion from unsigned
    /// to signed, but if needed, replace values greater than 127 with alpha-256 or alphaUB. Interpolated.
    #[nullable]
    text_opacity: byte;
}
