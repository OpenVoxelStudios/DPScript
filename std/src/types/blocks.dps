/// Block state.
#[allow(incomplete)]
pub struct BlockState {
    /// The identifier of the block to use.
    #[nullable]
    #[hint(block_id)]
    Name: str;

    /// (Optional, can be empty) Block properties. Unspecified properties of the specified block will be set
    /// to their default values.
    #[nullable]
    #[hint(block_state_property)]
    Properties: NBT;
}
