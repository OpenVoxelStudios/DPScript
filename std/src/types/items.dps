/// A single item stack.
#[allow(incomplete)]
pub struct ItemStack {
    /// The resource location of the item.
    #[nullable]
    #[hint = "item_id"]
    id: Ident,

    /// Number of items stacked in this inventory slot. Any item can be stacked, even if unstackable through normal
    /// means. Defaults to 1 if not specified.
    #[nullable]
    count: int,

    /// Optional map of additional (non-default) data components.
    #[nullable]
    #[hint = "data_component"]
    components: NBT,
}
