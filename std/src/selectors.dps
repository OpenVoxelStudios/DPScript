import std::types::base::NBT;
import std::types::base::Ident;
import std::types::math::FVec3;
import std::types::entities::Entity;
import std::intrinsics::dsl_entity_id;
// import std::types::players::Player; // TODO: Player type

pub const self: Entity = @"@s";
pub const nearest_entity: Entity = @"@n";
pub const nearest_player: Entity = @"@p";
pub const random_player: Entity = @"@r";
pub const all_players: [Entity] = @"@a";
pub const all_entities: [Entity] = @"@e";

#[cmd("tellraw {target} {message}")]
pub fn [Entity]::tellraw(#[this] target: Entity, message: NBT);

#[cmd("give {target} {item}")]
pub fn Entity::give(#[this] target: Entity, #[hint = "item"] item: Ident);

#[cmd("give {target} {item} {data}")]
pub fn Entity::give_nbt(#[this] target: Entity, #[hint = "item"] item: Ident, data: NBT);

#[cmd("tp {target} {position}")]
pub fn Entity::tp(#[this] target: Entity, position: FVec3);
