import std::types::Ident;
import std::types::FVec3;
import std::types::NBT;
import std::types::int;

objective compiler_support = "dummy";

#[cmd("summon {id}")]
pub fn summon(#[hint = "entity_id"] id: Ident);

#[cmd("summon {id} {position}")]
pub fn summon_at(#[hint = "entity_id"] id: Ident, position: FVec3);

#[cmd("summon {id} {position} {data}")]
pub fn summon_with(#[hint = "entity_id"] id: Ident, position: FVec3, data: NBT);

#[cmd("forceload add {x} {z}")]
pub fn forceload_add(x: int, z: int);
