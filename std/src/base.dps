#[cmd("tellraw {target} {message:nbt}")]
pub facade fn tellraw(target: Selector, message: Any);

#[cmd("summon {id}")]
pub facade fn summon(#[id(entity_type)] id: Identifier);

#[cmd("summon {id} {position}")]
pub facade fn summon_at(#[id(entity_type)] id: Identifier, position: Pos3);

#[cmd("summon {id} {position} {data}")]
pub facade fn summon_with(#[id(entity_type)] id: Identifier, position: Pos3, data: NBT);

#[cmd("give {target} {item}")]
pub facade fn give(target: Selector, #[id(item)] item: Identifier);

#[cmd("give {target} {item} {data}")]
pub facade fn give_nbt(target: Selector, #[id(item)] item: Identifier, data: NBT);

#[cmd("forceload add {position}")]
pub facade fn forceload_add(position: Pos2);

#[cmd("tp {target} {position}")]
pub facade fn tp_pos(target: Selector, position: Pos3);
