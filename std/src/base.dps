module std/base;

#[cmd("tellraw %% [\"\", %%]")]
pub facade fn tellraw(who: Selector, message: Component[]);

#[cmd("summon %%")]
pub facade fn summon(ent: Entity);

#[cmd("summon %% %%")]
pub facade fn summon_at(ent: Entity, position: Pos3);

#[cmd("summon %% %% %%")]
pub facade fn summon_with(#[id(entity_type)] ent: Identifier, position: Pos3, data: NBT);

#[cmd("give %% %%")]
pub facade fn give(ent: Entity, #[id(item)] item: Identifier);

#[cmd("give %% %% %%")]
pub facade fn give_nbt(ent: Entity, #[id(item)] item: Identifier, data: NBT);

#[cmd("forceload add %% %%")]
pub facade fn forceload_add(position: Pos2);

#[cmd("tp %% %%")]
pub facade fn tp_pos(ent: Entity, position: Pos3);
