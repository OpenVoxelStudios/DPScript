/// Converts any value to a string.
pub inline compiler fn stringify(value: Any) -> str;

#[cmd("summon {id}")]
pub facade fn summon(#[id(entity_type)] id: Ident);

#[cmd("summon {id} {position}")]
pub facade fn summon_at(#[id(entity_type)] id: Ident, position: Pos);

#[cmd("summon {id} {position} {data}")]
pub facade fn summon_with(#[id(entity_type)] id: Ident, position: Pos, data: NBT);

#[cmd("forceload add {x} {z}")]
pub facade fn forceload_add(x: int, z: int);
