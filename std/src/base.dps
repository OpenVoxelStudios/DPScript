objective compiler_support: dummy = "__dpscript__.compiler.support";

#[cmd("summon {id}")]
pub facade fn summon(#[id(entity_type)] id: Ident);

#[cmd("summon {id} {position}")]
pub facade fn summon_at(#[id(entity_type)] id: Ident, position: Pos3);

#[cmd("summon {id} {position} {data}")]
pub facade fn summon_with(#[id(entity_type)] id: Ident, position: Pos3, data: NBT);

#[cmd("forceload add {x} {z}")]
pub facade fn forceload_add(x: int, z: int);
