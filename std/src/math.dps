objective int_math: dummy = "int_math";
const value: Selector = selector: "dpscript.std.int_math.value";

pub operator fn int::add(#[this] #[enforce(clone)] x: int, y: int) -> int {
    int_math[value] = x;
    int_math[value] += y;

    return int_math[value];
}

pub operator fn int::sub(#[this] #[enforce(clone)] x: int, y: int) -> int {
    int_math[value] = x;
    int_math[value] -= y;

    return int_math[value];
}

pub operator fn int::mul(#[this] #[enforce(clone)] x: int, y: int) -> int {
    int_math[value] = x;
    int_math[value] *= y;

    return int_math[value];
}

pub operator fn int::div(#[this] #[enforce(clone)] x: int, y: int) -> int {
    int_math[value] = x;
    int_math[value] /= y;

    return int_math[value];
}

pub operator fn int::mod(#[this] #[enforce(clone)] x: int, y: int) -> int {
    int_math[value] = x;
    int_math[value] %= y;

    return int_math[value];
}
