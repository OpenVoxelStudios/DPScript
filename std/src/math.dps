import std::gm::simple::gm_add;
import std::gm::simple::gm_negate;
import std::gm::sqrt::gm_sqrt;

objective int_math: dummy = "int_math";
const value: Selector = selector: "dpscript.std.int_math.value";

pub operator fn int::add(#[this] #[enforce(clone)] x: int, y: int) -> int {
    int_math[value] = x;
    int_math[value] += y;

    return int_math[value];
}

pub operator fn int::sub(#[this] #[enforce(clone)] x: int, y: int) -> int {
    int_math[value] = x;
    int_math[value] -= y;

    return int_math[value];
}

pub operator fn int::mul(#[this] #[enforce(clone)] x: int, y: int) -> int {
    int_math[value] = x;
    int_math[value] *= y;

    return int_math[value];
}

pub operator fn int::div(#[this] #[enforce(clone)] x: int, y: int) -> int {
    int_math[value] = x;
    int_math[value] /= y;

    return int_math[value];
}

pub operator fn int::mod(#[this] #[enforce(clone)] x: int, y: int) -> int {
    int_math[value] = x;
    int_math[value] %= y;

    return int_math[value];
}

pub operator fn int::negate(#[this] #[enforce(clone)] x: int) -> int {
    int_math[value] = x;
    int_math[value] *= -1;

    return int_math[value];
}

pub operator fn float::add(#[this] #[enforce(clone)] x: float, y: float) -> float {
    return gm_add(x, y);
}

pub operator fn float::negate(#[this] #[enforce(clone)] x: float) -> float {
    return gm_negate(x);
}

pub fn float::sqrt(#[this] #[enforce(clone)] x: float) -> float {
    return gm_sqrt(x);
}
