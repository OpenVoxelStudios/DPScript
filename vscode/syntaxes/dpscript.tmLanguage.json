{
    "displayName": "DPScript",
    "name": "dps",
    "patterns": [
        { "include": "#all" }
    ],
    "repository": {
        "all": {
            "patterns": [
                { "include": "#comments" },
                { "include": "#block-comments" },
                { "include": "#items" },
                { "include": "#keywords" },
                { "include": "#literals" }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "comment": "line comments",
                    "name": "comment.line.double-slash.dps",
                    "match": "(//).*$",
                    "captures": { "1": { "name": "punctuation.definition.comment.dps" } }
                }
            ]
        },
        "block-comments": {
            "patterns": [
                {
                    "comment": "empty block comments",
                    "name": "comment.block.dps",
                    "match": "/\\*\\*/"
                },
                {
                    "comment": "block comments",
                    "name": "comment.block.dps",
                    "begin": "/\\*(?!\\*)",
                    "end": "\\*/",
                    "patterns": [ { "include": "#block-comments" } ]
                }
            ]
        },
        "ident": {
            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b"
        },
        "items": {
            "patterns": [
                {
                    "name": "function.dps",
                    "match": "\\b(?:(pub|const|operator)\\s+)*(fn)\\s+(?:([A-Za-z_][A-Za-z0-9_]*)(::))?([A-Za-z_][A-Za-z0-9_]*)\\b(?:(\\()(?:([A-Za-z_][A-Za-z0-9_]*)(:)\\s*([A-Za-z_][A-Za-z0-9_]*))*(\\)))",
                    "captures": {
                        "1": { "name": "entity.name.tag.dps" },
                        "2": { "name": "keyword.control.dps" },
                        "3": { "name": "entity.name.type.dps" },
                        "4": { "name": "keyword.operator.dps" },
                        "5": { "name": "entity.name.function.dps" },
                        "6": { "name": "punctuation.parens.dps" },
                        "7": { "name": "storage.dps" },
                        "8": { "name": "punctuation.separator.var.dps" },
                        "9": { "name": "entity.name.type.dps" },
                        "10": { "name": "punctuation.parens.dps" }
                    }
                },
                {
                    "name": "constant.dps",
                    "match": "\\b(?:(pub)\\s+)*(const)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:(:)\\s*([A-Za-z_][A-Za-z0-9_]*))?\\s*(=)",
                    "captures": {
                        "1": { "name": "entity.name.tag.dps" },
                        "2": { "name": "keyword.control.dps" },
                        "3": { "name": "variable.other.name.dps" },
                        "4": { "name": "punctuation.separator.var.dps" },
                        "5": { "name": "entity.name.type.dps" },
                        "6": { "name": "punctuation.separator.value.dps" }
                    }
                },
                {
                    "name": "variable.dps",
                    "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:(:)\\s*([A-Za-z_][A-Za-z0-9_]*))?\\s*(=)",
                    "captures": {
                        "1": { "name": "keyword.control.dps" },
                        "2": { "name": "variable.other.dps" },
                        "3": { "name": "punctuation.separator.var.dps" },
                        "4": { "name": "entity.name.type.dps" },
                        "5": { "name": "punctuation.separator.value.dps" }
                    }
                },
                {
                    "begin": "{",
                    "end": "}",
                    "beginCaptures": { "0": { "name": "punctuation.block.begin.dps" } },
                    "endCaptures": { "0": { "name": "punctuation.block.end.dps" } },
                    "patterns": [ { "include": "#all" } ]
                },
                {
                    "begin": "([A-Za-z_][A-Za-z0-9_]*)(\\()",
                    "end": "\\)",
                    "beginCaptures": {
                        "1": { "name": "entity.name.function.dps" },
                        "2": { "name": "punctuation.call.begin.dps" }
                    },
                    "endCaptures": { "0": { "name": "punctuation.call.end.dps" } },
                    "patterns": [ { "include": "#all" } ]
                },
                {
                    "match": "\\b(import)\\s+((?:\\b([A-Za-z_][A-Za-z0-9_]*)\\b(::)\\b)*)([A-Za-z_][A-Za-z0-9_]*)(;)",
                    "captures": {
                        "1": { "name": "keyword.control.dps" },
                        "2": { "name": "entity.section.dps" },
                        "3": { "name": "entity.section.dps" },
                        "4": { "name": "punctuation.separator.import.dps" },
                        "5": { "name": "entity.name.dps" },
                        "6": { "name": "punctuation.semicolon.dps" }
                    }
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "match": "\\b(true|false)\\b",
                    "name": "constant.language.dps"
                },
                {
                    "match": "\\b(\\d+(\\.\\d+)?)\\b",
                    "name": "constant.numeric.dps"
                },
                {
                    "begin": "\"",
                    "end": "\"",
                    "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.dps" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.string.end.dps" } },
                    "name": "string.quoted.double.dps",
                    "patterns": [
                        {
                            "_comment": "stolen from javascript, thx fam <3",
                            "match": "\\\\(x\\h{2}|u\\h{4}|u\\{\\h+}|[012][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)",
                            "name": "constant.character.escape.dps"
                        }
                    ]
                },
                {
                    "begin": "\\[",
                    "end": "\\]",
                    "beginCaptures": { "0": { "name": "punctuation.definition.array.begin.dps" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.array.end.dps" } },
                    "patterns": [ { "include": "#all" } ]
                },
                {
                    "match": "[A-Za-z_][A-Za-z0-9_]*",
                    "name": "entity.other.dps"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.item.top_level.dps",
                    "match": "\\b(init|tick)\\b"
                },
                {
                    "name": "keyword.control.item.inner.dps",
                    "match": "\\b(at|if|for|in)\\b"
                },
                {
                    "name": "punctuation.misc.dps",
                    "match": ",|\\."
                },
                {
                    "name": "keyword.operator.dps",
                    "match": "\\+|\\-|\\*|\\/|%|=|!"
                }
            ]
        }
    },
    "scopeName": "source.dpscript"
}
