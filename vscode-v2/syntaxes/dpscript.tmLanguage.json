{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "DPScript",
    "patterns": [
        {
            "include": "#all"
        }
    ],
    "repository": {
        "all": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#block-comments"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#storage"
                },
                {
                    "include": "#support"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#other"
                }
            ]
        },
        "comments": {
			"patterns": [
				{
					"comment": "line comments",
					"name": "comment.line.double-slash.dpscript",
					"match": "(//).*$",
					"captures": {
						"1": {
							"name": "punctuation.definition.comment.dpscript"
						}
					}
				}
			]
		},
		"block-comments": {
			"patterns": [
				{
					"comment": "empty block comments",
					"name": "comment.block.dpscript",
					"match": "/\\*\\*/"
				},
				{
					"comment": "block comments",
					"name": "comment.block.dpscript",
					"begin": "/\\*(?!\\*)",
					"end": "\\*/",
					"patterns": [
						{
							"include": "#block-comments"
						}
					]
				}
			]
		},
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.dpscript",
                    "match": "\\b(if|for|return|export|import|goto|init|tick|at)\\b"
                },
                {
                    "name": "entity.name.type.dpscript",
                    "match": "\\b(component|selector|c|entity|path|pos|nbt|store)\\s*:\\b"
                },
                {
					"name": "keyword.operator.logical.dpscript",
					"match": "(\\|\\||&&|!)"
				},
                {
					"name": "keyword.operator.comparison.dpscript",
					"match": "(=(=)?(?!>)|!=|<=|(?<!=)>=)"
				}
            ]
        },
        "storage": {
            "patterns": [
                {
                    "name": "storage.type.function.dpscript",
                    "match": "\\b(?:fn)\\s+([A-Za-z0-9_]+)\\b",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.dpscript"
                        }
                    }
                },
                {
                    "name": "storage.type.block.dpscript",
                    "match": "\\b(?:sub)\\s+([A-Za-z0-9_]+)\\b",
                    "captures": {
                        "1": {
                            "name": "variable.other.dpscript"
                        }
                    }
                },
                {
                    "name": "storage.type.module.dpscript",
                    "match": "\\b(?:module)\\s+([A-Za-z0-9_]+)\\b",
                    "captures": {
                        "1": {
                            "name": "entity.name.class.dpscript"
                        }
                    }
                },
                {
                    "name": "storage.type.variable.dpscript",
                    "match": "\\b(?:let|objective|const)\\s+([A-Za-z0-9_]+)\\b",
                    "captures": {
                        "1": {
                            "name": "variable.name.dpscript"
                        }
                    }
                },
                {
                    "name": "storage.modifier.dpscript",
                    "match": "\\b(pub|ref|facade|compiler|inline)\\b"
                }
            ]
        },
        "support": {
            "patterns": [
                {
                    "name": "support.type.dpscript",
                    "match": "\\b(Identifier|NBTPath|Store|NBT|Selector|Component|Pos2|Entity|Pos3|Any|float|int|double)\\b"
                },
                {
                    "name": "constant.language.bool.dpscript",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "meta.function.call.dpscript",
                    "match": "((?:[A-Za-z0-9_]+\\.?)+)\\s*(?:\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.dpscript"
                        }
                    }
                },
                {
                    "name": "meta.preprocessor.dpscript",
                    "begin": "#\\[",
                    "end": "\\]",
                    "patterns": [
                        {
                            "include": "#strings"
                        },
                        {
                            "include": "#numbers"
                        },
                        {
                            "name": "keyword.other.dpscript",
                            "match": "\\b(gen|item|entity_type|block|any|sound_event)\\b"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.dpscript",
                    "match": "\\b[+-]?\\d[\\d]*(\\.?)[\\d]*(f|d|s|b)?\\b",
                    "captures": {
                        "1": {
                            "name": "punctuation.separator.dot.decimal.dpscript"
                        },
                        "2": {
                            "name": "entity.name.type.numeric.dpscript"
                        }
                    }
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.dpscript",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.dpscript",
                    "match": "\\\\."
                }
            ]
        },
        "other": {
            "patterns": [
                {
                    "name": "variable.name",
                    "match": "[A-Za-z0-9_]+"
                }
            ]
        }
    },
    "scopeName": "source.dpscript"
}
