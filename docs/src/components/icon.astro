<script>
    const icon = document.getElementById("icon")!;
    const SPEED = 2;
    let index = 0;
    let eyeEffect = 0;
    let mouthEffect = 0;
    let deltaX = 0;
    let deltaY = 0;

    document.addEventListener("mousemove", (e) => {
        if (!e) {
            deltaX = 0;
            deltaY = 0;
            return;
        }
        const rect = icon.getBoundingClientRect();
        deltaX = e.clientX - rect.left - rect.width / 2;
        deltaY = e.clientY - rect.top - rect.height / 2;
    });

    function h(i: number): string {
        return Math.abs(index - i) <= SPEED ? "-" : "#";
    }

    const eyes = {
        default: ["  ##  ", " #  # ", "  ##  "],
        closed: ["      ", " #### ", "  ##  "],
        left: [" ##   ", "# #   ", " ##   "],
        right: ["   ## ", "   # #", "   ## "],
    };
    const mouth = {
        default: ["   #    #   ", "    ####    ", "            "],
        neutral: ["    ####    ", "            ", "            "],
        bottom: ["            ", "    ####    ", "            "],
        w: ["   # ## #   ", "    #  #    ", "            "],
    };

    function getMouth(row: number): string {
        if (mouthEffect == 1) {
            return mouth.w[row];
        }
        if (mouthEffect == 2) {
            if (index % 20 < 10) {
                return mouth.neutral[row];
            }
            return mouth.bottom[row];
        }

        return mouth.default[row];
    }

    function getEye(row: number): string {
        let current: keyof typeof eyes = "default";
        if (eyeEffect === 1 && Math.abs((index % 20) - 2) < 2) {
            current = "closed";
        } else if (deltaX > 75) {
            current = "right";
        } else if (deltaX < -75) {
            current = "left";
        }

        const eye = [...eyes[current]];
        if (deltaY > 75) eye.unshift("      ");
        else eye.push("      ");

        return eye[row];
    }

    function getMiddle(row: number): string {
        if (4 <= row && row <= 7) {
            return getEye(row - 4) + getEye(row - 4);
        }

        if (9 <= row && row <= 11) {
            return getMouth(row - 9);
        }

        return "";
    }

    function getMascot(): string {
        const mascot = [
            ["      ##", "##      "],
            ["   ###  ", "  ###   "],
            [" ##     ", "     ## "],
            ["#       ", "       #"],
            ["# ", " #"],
            ["# ", " #"],
            ["# ", " #"],
            ["# ", " #"],
            ["#       ", "       #"],
            ["# ", " #"],
            ["# ", " #"],
            [h(SPEED * 20) + " ", " " + h(SPEED)],
            [h(SPEED * 19) + "       ", "       " + h(SPEED * 2)],
            [
                `${h(SPEED * 18)}  ${h(SPEED * 15)}${h(SPEED * 14)}  ${h(SPEED * 11)}`,
                `${h(SPEED * 10)}  ${h(SPEED * 7)}${h(SPEED * 6)}  ${h(SPEED * 3)}`,
            ],
            [
                ` ${h(SPEED * 17)}${h(SPEED * 16)}  ${h(SPEED * 14)}${h(SPEED * 12)} `,
                ` ${h(SPEED * 9)}${h(SPEED * 8)}  ${h(SPEED * 5)}${h(SPEED * 4)} `,
            ],
        ];

        return mascot
            .map((row, i) => {
                return (
                    (Math.abs(index - 10 - i) < 5 ? "" : " ") +
                    row[0] +
                    getMiddle(i) +
                    row[1]
                );
            })
            .join("\n");
    }

    setInterval(() => {
        index++;
        if (index >= 50) {
            index = 0;
            eyeEffect = Math.floor(Math.random() * 3);
            mouthEffect = Math.floor(Math.random() * 3);
        }

        icon.innerText = getMascot();
    }, 100);
</script>
