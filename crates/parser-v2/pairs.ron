        rule: body,
        span: Span {
            str: "import std::{\n    entity::tp,\n    gm::{gm_std, math_entity},\n    math::sub,\n    selectors::Pos,\n    transform::{transformation, translation},\n    intrinsics::{slice, float_of},\n};\n\nconst looper: Selector = selector: \"__sqrt_loop\";\n\npub fn sqrt(x: float) -> float {\n    gm_std[looper] = 0;\n\n    let temp = nbt: {\n        var1: x,\n        var2: 1,\n        var3: [0d, 0d, 0d, 0d, 0d, 1d, 0d, 0d, 0d, 0d, 1d, 0d, 0d, 0d, 0d, 2d],\n        var4: [0f, 0f, 0f, x, 0f, 1f, 0f, 0f, 0f, 0f, 1f, 0f, 0f, 0f, 0f, 0f],\n    };\n\n    return sqrt_handling(x, 1, temp);\n}\n\nfn sqrt_handling(var1: float, var2: float, ref temp: NBT) -> float {\n    at pos: [~0, var1, ~0] {\n        math_entity.tp(pos: [29999999, ~var2, 91665]);\n    }\n\n    temp.var3 = [temp.var3[0], math_entity.Pos[1], temp.var3[2]];\n    math_entity.transformation = temp.var3;\n    temp.var1 = math_entity.transformation.translation[0];\n\n    temp.var4[15] = temp.var1;\n    math_entity.transformation = temp.var4;\n    temp.var2 = math_entity.transformation.translation[0];\n\n    gm_std[looper] += 1;\n    positive_subtract(var2, temp);\n\n    if (gm_std[looper] < 20) && temp.v1m2p != \"-\" {\n        sqrt_handling(temp.var1, temp.var2, temp);\n    }\n\n    math_entity.tp(pos: [29999999, 0, 91665]);\n\n    return temp.var1;\n}\n\nfn positive_subtract(var2: float, ref temp: NBT) {\n    at pos: [~0, float_of(temp.var1), ~0] {\n        at pos: [~0, ~0 - 0.000000001, ~0] {\n            math_entity.tp(pos: [29999999, ~0 - var2, 91665]);\n        }\n    }\n\n    temp.v1m2p = math_entity.Pos[1].slice(0, 1);\n}\n",
            start: 0,
            end: 1534,
        },
