import std::gm::sqrt::sqrt;
import std::selectors::tellraw;
import std::selectors::all_players;
import std::math::add;

// compiler note: `@<ident>` means selector, `@[x, y, z]` means position

// This is a basic function:
pub fn say_hi(player: Selector) {
    // `const` means this is just something that gets substituted for the real value during compilation.
    // Strings and NBT objects are automatically converted to text if the compiler sees that it's needed!
    const base: Text = "Hello, " + { color: "green" };

    // this is syntactic sugar - this is really: new array, push(...), push(...)
    // `player + { ... }` converts the selector to a text component!
    let text = [base, player + { color: "red" }, "!"];

    // tell them something!
    player.tellraw(text);
}

// Every module can have one or more init blocks, which will be their own functions and added to the load tag.
init {
    const txt: Text = "Hello, world!" + { color: "green" };
    let data = sqrt(100);
    
    const base: Text = "The square root of 100 is: ";
    let msg = [base, data];

    all_players.tellraw([txt]);
    all_players.tellraw(msg);

    const calc_base: Text = "1 + 2 is: ";
    let calc_msg = [base, 1 + 2];

    // this one expression is gonna require so much type inference lmfao
    all_players.tellraw(calc_msg);

    // execute as @a run ...
    for player in all_players {
        say_hi(player);
    }
}

// Every module can also have one or more tick blocks, which will be their own functions and added to the tick tag.
tick {
    // idk, do something here.
}
