root = true

[*]
charset = utf-8

[*.{json,toml,yml,gyp}]
indent_style = space
indent_size = 4

[*.js]
indent_style = space
indent_size = 4

[*.scm]
indent_style = space
indent_size = 4

[*.{c,cc,h}]
indent_style = space
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_style = space
indent_size = 4

[*.swift]
indent_style = space
indent_size = 4

[*.go]
indent_style = space
indent_size = 4

[Makefile]
indent_style = space
indent_size = 4

[parser.c]
indent_size = 4

[{alloc,array,parser}.h]
indent_size = 4
